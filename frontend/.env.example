# Public build configuration. No keys or database URLs here.
VITE_API_BASE=/api
VITE_ENABLE_DEV_WALLET=false
# Local Vite only; production uses BACKEND_URL at runtime in server.mjs.
API_PROXY_TARGET=http://127.0.0.1:3011
# Production static-server environment (not bundled into browser code):
# PORT=8000
# BACKEND_URL=https://your-api-service.koyeb.app

# Runtime only, not VITE_*:
# FRONTEND_PROXY_TOKEN=same-private-proxy-credential-as-API
# TRUSTED_PROXY_HOPS=1  # production ingress; zero for direct local server
