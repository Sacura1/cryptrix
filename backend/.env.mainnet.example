# LOCAL DEPLOYMENT ONLY. Never upload this file to Koyeb or commit it.
# npm run arc:mainnet:prepare fills SIGNER_ENCRYPTION_KEY below.
key=
ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
SIGNER_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=verify-full
SIGNER_STATE_NAMESPACE=signer:mainnet:v4
SIGNER_ENCRYPTION_KEY=
# To keep the current Koyeb encryption key, copy its value above BEFORE first deployment.
# Existing Koyeb tokens, ports, hosts and URLs are not deployment inputs.
# Optional: contract owner and initial platform-fee recipient. Defaults to deployment wallet.
# FEE_OWNER=0x...
MAINNET_SERVICE_USDC=0.25
MAINNET_MAX_SPEND_USDC=1
