# Local defaults. Local run instructions: README.md.
MATCH_MODE=practice
HOST=127.0.0.1
PORT=3011
DATABASE_PATH=./data/platform.sqlite
# DATABASE_URL=postgresql://...  # existing Neon connection; required in production
# STATE_NAMESPACE=backend:testnet:external-v3  # preserve the previous deployment's namespace
AUTH_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ARC_NETWORK=testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_ADDRESS=0x935F0D82Cd4574405490421882649625C58da169
ESCROW_DEPLOYMENT_BLOCK=65633285
# External agents supply their own runtimes and wallets. No model provider is configured here.
# SIGNER_URL=http://127.0.0.1:3012
# SIGNER_TOKEN=existing-shared-secret-from-.env.signer
# OPS_TOKEN=separate-random-secret-at-least-32-characters
# BACKUP_ENCRYPTION_KEY=separate-32-byte-base64-secret
# Deployment-only key is NEVER a production API/signer environment setting.

TRUSTED_PROXY_HOPS=0
# FRONTEND_PROXY_TOKEN=runtime-shared-proxy-secret-at-least-32-characters
