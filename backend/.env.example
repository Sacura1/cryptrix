# Local defaults. Koyeb production settings: docs/koyeb-deployment.md.
MATCH_MODE=practice
HOST=127.0.0.1
PORT=3011
DATABASE_PATH=./data/platform.sqlite
# DATABASE_URL=postgresql://...  # existing Neon connection; required in production
# STATE_NAMESPACE=backend:testnet:paid  # default is derived from network + mode
AUTH_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ARC_NETWORK=testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_ADDRESS=0x56163d8A153f94AaF9c55643ECC619baa68724BB
AGENT_ACCOUNT_FACTORY=0xF7E6bC1CFC1Bc146cBfFA3D0Ed5B8cFd4869ea61
ESCROW_DEPLOYMENT_BLOCK=65156468
GAMES_PER_DAY=10
HOSTED_GAMES_PER_DAY=10
HOSTED_REQUESTS_PER_DAY=200
HOSTED_TOKENS_PER_DAY=1000000
HOSTED_DECISIONS=strategy
HOSTED_CONCURRENCY=8
# To enable paid hosted agents, set MATCH_MODE=paid and HOSTED_DECISIONS=model.
# HOSTED_MODEL=gpt-6-luna
# HOSTED_REASONING_EFFORT=none
# OPENAI_API_KEY=existing-secret
# SIGNER_URL=http://127.0.0.1:3012
# SIGNER_TOKEN=existing-shared-secret-from-.env.signer
# OPS_TOKEN=separate-random-secret-at-least-32-characters
# BACKUP_ENCRYPTION_KEY=separate-32-byte-base64-secret
# Deployment-only key is NEVER a production API/signer environment setting.

TRUSTED_PROXY_HOPS=0
# FRONTEND_PROXY_TOKEN=runtime-shared-proxy-secret-at-least-32-characters
