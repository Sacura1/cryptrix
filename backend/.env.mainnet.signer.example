# Apply only these changes to the existing Koyeb signer environment.
# Keep its current hosts, ports, database URL and SIGNER_TOKEN.
SIGNER_STATE_NAMESPACE=signer:mainnet:v4
SIGNER_ENCRYPTION_KEY=REPLACE_FROM_LOCAL_MAINNET_ENV
ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ESCROW_ADDRESS=REPLACE_FROM_MAINNET_MANIFEST
GAS_SPONSOR_ENABLED=false
