# Separate signer service. Do not generate replacement encryption keys after deployment.
SIGNER_HOST=127.0.0.1
SIGNER_PORT=3012
SIGNER_DATABASE=./data/signer/keys.sqlite
# SIGNER_DATABASE_URL=postgresql://...  # Neon; required in production
SIGNER_STATE_NAMESPACE=signer:testnet
# Wait for a stopped instance's database lease. Koyeb must use Immediate deployments.
DATABASE_STARTUP_WAIT_MS=180000
# SIGNER_TOKEN=existing-shared-service-secret-at-least-32-characters
# SIGNER_ENCRYPTION_KEY=existing-32-byte-base64-secret
ARC_NETWORK=testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_ADDRESS=0x935F0D82Cd4574405490421882649625C58da169
GAS_SPONSOR_ENABLED=true
GAS_TOPUP_USDC=0.05
GAS_BUDGET_USDC=3
# Only service roles: resolver, keeper and gas sponsor. No participant or model keys.
