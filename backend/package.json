{
  "name": "cryptrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "solc": {
      "tmp": "^0.2.6"
    }
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "tsx scripts/compile-contracts.ts",
    "signer": "node --env-file-if-exists=.env.signer --import tsx src/signer-server.ts",
    "signer:start": "node --env-file-if-exists=.env.signer dist/src/signer-server.js",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "arc:check": "node --env-file-if-exists=.env --import tsx scripts/arc-check.ts",
    "arc:deploy": "node --env-file-if-exists=.env --import tsx scripts/deploy-arc.ts",
    "check": "npm run typecheck",
    "arc:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-arc.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@openzeppelin/contracts": "^5.6.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "viem": "^2.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "solc": "^0.8.30",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
